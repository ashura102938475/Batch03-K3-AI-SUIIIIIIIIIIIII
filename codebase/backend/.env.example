# Default Provider (nvidia, gemini, openai, openrouter, anthropic)
DEFAULT_PROVIDER=nvidia
LLM_REQUEST_TIMEOUT_SECONDS=90

# NVIDIA Config
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
# Fast tier for intent/scope classification (companion/classify.py). It is only
# consulted when the deterministic rules fall through, and any failure falls straight
# back to those rules — so a wrong value here degrades quality SILENTLY.
# Verified working on integrate.api.nvidia.com: nvidia/nemotron-3-nano-30b-a3b,
#                                               meta/llama-3.1-8b-instruct
# Listed by /models but 404 on /chat/completions: google/gemma-3-1b-it,
#                       google/gemma-3-4b-it, nvidia/nvidia-nemotron-nano-9b-v2
# Check the live value at GET /health -> "fast_model".
NVIDIA_FAST_MODEL=meta/llama-3.1-8b-instruct
# Hard deadline for the classifier call. The first call of a process pays TLS setup
# (~2.3s); later calls are ~0.4s. Exceeding this falls back to rules, never blocks.
FAST_CLASSIFIER_TIMEOUT_SECONDS=4.0

# How to treat environment-setup questions ("setup torch on m1 fails"):
#   out_of_scope (default) = course-material tutor, hand off to TA
#   external               = allow a Tavily web lookup
EXTERNAL_SUPPORT_POLICY=out_of_scope

# Gemini Config
GEMINI_API_KEY=
GEMINI_MIN_REQUEST_INTERVAL=4
GEMINI_MAX_RETRIES=3

# External Citations APIs & Tools
ARXIV_USER_AGENT=AI20k-Day04-Research-Agent/1.0 (educational lab)
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# TA Channel Push Notification (Telegram Bot & Webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TA_WEBHOOK_URL=

# Optional data-pack overrides.
VLEARN_SLIDES_DIR=
VLEARN_TRANSCRIPT_DIR=
VLEARN_TRANSCRIPT_PATH=
