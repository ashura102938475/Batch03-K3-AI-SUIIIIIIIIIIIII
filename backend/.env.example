# Default Provider (nvidia, gemini, openai, openrouter, anthropic)
DEFAULT_PROVIDER=nvidia
LLM_REQUEST_TIMEOUT_SECONDS=90

# NVIDIA Config
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Gemini Config
GEMINI_API_KEY=
GEMINI_MIN_REQUEST_INTERVAL=4
GEMINI_MAX_RETRIES=3

# External Citations APIs & Tools
ARXIV_USER_AGENT=AI20k-Day04-Research-Agent/1.0 (educational lab)
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# TA Channel Push Notification (Telegram Bot & Webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TA_WEBHOOK_URL=

# Optional data-pack overrides.
VLEARN_SLIDES_DIR=
VLEARN_TRANSCRIPT_DIR=
VLEARN_TRANSCRIPT_PATH=
