# Copy file này thành .env rồi điền key. KHÔNG commit .env.

# Default Provider (nvidia, gemini, openai, openrouter, anthropic)
DEFAULT_PROVIDER=nvidia

# NVIDIA Config
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Gemini Config
GEMINI_API_KEY=
GEMINI_MIN_REQUEST_INTERVAL=4
GEMINI_MAX_RETRIES=3

# Tavily External Citations Search API
TAVILY_API_KEY=

# Tuỳ chọn — trỏ tới transcript thật của khoá.
# Mặc định: ../data/vlearn-pack/transcript/transcript-04-clean.md
# Transcript KHÔNG được copy vào codebase/ (luật bảo mật data pack).
VLEARN_TRANSCRIPT_PATH=
